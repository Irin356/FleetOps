# ==============================================================================
# BYTEBEAM FLEETOPS - SUPABASE CONFIGURATION
# ==============================================================================
# 1. Sign up / Log in to https://supabase.com
# 2. Open your Supabase Project -> Settings -> API
# 3. Copy the "Project URL" into VITE_SUPABASE_URL
# 4. Copy the "anon / public" key into VITE_SUPABASE_ANON_KEY
# 5. NEVER paste the service_role key here (service_role is secret)!
# ==============================================================================

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
